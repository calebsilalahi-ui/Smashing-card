# ─── Public site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://vip.smashingburger.id

# ─── Supabase (Project Settings → API) ───────────────────────────────────────
# Leave both NEXT_PUBLIC_SUPABASE_* empty to run a demo-only deployment (Presenter Mode).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for stamp/redeem RPCs, consent logging, account deletion and the daily cron.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Vision AI (set at least one; Gemini wins if both are set unless VISION_PROVIDER is given) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: force a provider when both keys exist (gemini | anthropic)
VISION_PROVIDER=

# ─── Store alerts (Slack/Discord/Make/Zapier incoming webhook) ───────────────
# Receives: instant Helena Burger redemption alerts + the daily rotated staff PIN.
STORE_WEBHOOK_URL=

# ─── Web Push (generate with: npx web-push generate-vapid-keys) ──────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@smashingburger.id

# ─── Vercel Cron auth (Vercel sends "Authorization: Bearer $CRON_SECRET") ────
CRON_SECRET=
